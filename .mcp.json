{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--caps=vision"
      ]
    },
    "aspire": {
      "type": "stdio",
      "command": "aspire",
      "args": [
        "agent",
        "mcp"
      ]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "NuGet": {
      "type": "stdio",
      "command": "/usr/local/share/dotnet/dnx",
      "args": [
        "NuGet.Mcp.Server",
        "--yes"
      ],
      "tools": [
        "*"
      ]
    }
  }
}